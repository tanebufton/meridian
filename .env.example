# Ports / interfaces
PUBLIC_PORT=3001
PUBLIC_HOST=127.0.0.1
ADMIN_PORT=3002
# Default 127.0.0.1 = this machine / a local tunnel only. The admin UI is plain HTTP, so only change
# this to 0.0.0.0 (or a LAN/Tailscale address) if the network it's on is trusted and firewalled.
ADMIN_HOST=127.0.0.1

# Database
DATABASE_PATH=./data/meridian.db

# Sessions — MUST be a long random value (also encrypts 2FA secrets): openssl rand -hex 32
SESSION_SECRET=changeme_use_random_32_bytes

# Behind the Cloudflare Tunnel (cloudflared on this machine): trust it for the real client IP.
TRUST_CF_HEADERS=true
# Or list specific proxy IPs instead (e.g. cloudflared running on another host):
# TRUSTED_PROXIES=10.0.0.5

# Prometheus /metrics on the admin port. Leave unset to disable the endpoint entirely.
# METRICS_TOKEN=a-long-random-string

# Data retention (days)
RETENTION_RAW_DAYS=7
RETENTION_5MIN_DAYS=30
RETENTION_1HOUR_DAYS=365

# Probe defaults
DEFAULT_PROBE_INTERVAL=60
DEFAULT_PACKET_COUNT=10
# Maximum probes running at once
# PROBE_CONCURRENCY=15

# Node env
NODE_ENV=production
