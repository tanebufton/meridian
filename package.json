{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/public",
    "apps/admin"
  ],
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "build": "npm run build --workspace=apps/public && npm run build --workspace=apps/admin",
    "dev:api": "node server/api/index.js",
    "dev:admin": "node server/admin/index.js",
    "dev:probe": "node server/probe/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "test:ui": "node --test \"tests/ui/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT"
}
